 const handleOnBlur = useStableCallback(\n    (event: FocusEvent<HTMLInputElement>) => {\n      hide();\n      onBlurAction(event);\n    },\n  );\n\n  useEffect(reset, [filter, reset]);\n\n  return (\n    <Box\n      rcx-autocomplete\n      ref={containerRef}\n      onClick={useStableCallback(() => innerRef.current?.focus())}\n      flexGrow={1}\n      className={useMemo(\n        () => [error && 'invalid', disabled && 'disabled'],\n        [error, disabled],\n      )}\n    >\n      <Box\n        display='flex'\n        flexGrow={1}\n        alignItems='center'\n        flexWrap='wrap'\n        margin='neg-x4'\n        role='group'\n      >\n        <Margins all='x4'>\n          <Input\n            ref={mergedRefs}\n            onChange={useStableCallback((e: ChangeEvent<HTMLInputElement>) =>\n              setFilter?.(e.currentTarget.value),\n            )}\n            onBlur={handleOnBlur}\n            onFocus={show}\n            onKeyDown={handleKeyDown}\n            placeholder={\n              optionsAreVisible === AnimatedVisibility.HIDDEN || !value\n                ? placeholder\n                : undefined\n            }\n            order={1}\n            rcx-input-box--undecorated\n            value={filter}\n            disabled={disabled}\n            {...props}\n          />\n          {selected.map((itemSelected) =>\n            RenderSelected ? (\n              <RenderSelected\n                key={itemSelected.value}\n                selected={itemSelected}\n                onRemove={handleRemove}\n              />\n            ) : (\n              <Chip\n                key={itemSelected.value}\n                value={itemSelected.value}\n                children={itemSelected.label as ReactNode}\n                onClick={handleRemove}\n              />\n            ),\n          )}\n        </Margins>\n      </Box>\n      <Box rcx-autocomplete__addon>\n        <Icon\n          name={\n            optionsAreVisible === AnimatedVisibility.VISIBLE\n 